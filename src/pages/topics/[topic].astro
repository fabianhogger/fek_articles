---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { publishedArticles, topicSlug, type Article } from '../../lib/fek';

export async function getStaticPaths() {
  const articles = await publishedArticles();
  const byTopic = new Map<string, { name: string; articles: Article[] }>();
  for (const a of articles) {
    for (const name of a.data.topics) {
      const key = topicSlug(name);
      if (!byTopic.has(key)) byTopic.set(key, { name, articles: [] });
      byTopic.get(key)!.articles.push(a);
    }
  }
  return [...byTopic.entries()].map(([topic, value]) => ({ params: { topic }, props: value }));
}

const { name, articles } = Astro.props as { name: string; articles: Article[] };
---
<Base title={name}>
  <p class="eyebrow"><a href="/topics/">Θέματα</a></p>
  <h1>{name}</h1>
  <ul class="card-list">{articles.map((a) => <ArticleCard article={a} />)}</ul>
</Base>
